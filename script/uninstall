#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/common.sh
source "$SCRIPT_DIR/common.sh"

log_step "Select packages to unstow"
ensure_stow
select_packages

log_step "Removing stow packages"
stow --delete --verbose=2 --dir="$DOTFILES_ROOT" --target="$HOME" "${SELECTED_PACKAGES[@]}"

echo "Dotfiles unlinked successfully."
