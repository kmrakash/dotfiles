#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/common.sh
source "$SCRIPT_DIR/common.sh"

log_step "Select packages to stow"
ensure_stow
select_packages

log_step "Checking stow changes"
migrate_conflicting_targets
run_stow_preflight "${SELECTED_PACKAGES[@]}"

log_step "Applying stow packages"
stow --restow --verbose=2 --dir="$DOTFILES_ROOT" --target="$HOME" "${SELECTED_PACKAGES[@]}"

echo "Dotfiles linked successfully."
